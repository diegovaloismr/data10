---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'pt' as const;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang={lang} title={t('notFound.title')} description={t('notFound.body')} noIndex>
  <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-serif-editorial text-7xl font-bold text-ember-500">404</p>
    <h1 class="mt-4 font-serif-editorial text-3xl font-bold text-ink-950">{t('notFound.title')}</h1>
    <p class="mt-3 text-ink-700">{t('notFound.body')}</p>
    <a href={`${base}/pt/`} class="mt-8 rounded bg-ember-500 px-5 py-3 font-medium text-white hover:bg-ember-600">
      {t('notFound.cta')}
    </a>
  </div>
</BaseLayout>
