---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = 'pt' as const;
const t = useTranslations(lang);

const glossaryTerms = await getCollection('glossario', ({ data }) => data.relatedPosts.includes(post.id));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ArticleLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  category={post.data.category}
  tags={post.data.tags}
  readingTime={post.data.readingTime}
  cover={post.data.cover}
  coverAlt={post.data.coverAlt}
>
  <Content />

  {glossaryTerms.length > 0 && (
    <aside class="not-prose mt-12 rounded-lg border border-ink-100 bg-ink-50 p-5">
      <h2 class="font-serif-editorial text-lg font-bold text-ink-950">{t('blog.relatedTerms')}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {glossaryTerms.map((term) => (
          <li>
            <a
              href={`${base}/${lang}/glossario/${term.id}/`}
              class="inline-block rounded-full border border-ink-200 bg-white px-3 py-1 text-sm text-ink-800 hover:border-ember-500 hover:text-ember-600"
            >
              {term.data.term}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )}
</ArticleLayout>
