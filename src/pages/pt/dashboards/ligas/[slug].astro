---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BrasileiraoTable from '../../../../components/BrasileiraoTable.astro';
import ScorersTable from '../../../../components/ScorersTable.astro';
import HomeAwayTable from '../../../../components/HomeAwayTable.astro';
import StreaksTable from '../../../../components/StreaksTable.astro';
import AttackDefenseScatter from '../../../../components/charts/AttackDefenseScatter.astro';
import PointsRaceChart from '../../../../components/charts/PointsRaceChart.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import { useTranslations } from '../../../../i18n/utils';
import leaguesConfig from '../../../../data/leagues-config.json';

interface LeagueConfig {
  code: string;
  slug: string;
  name: string;
  country: string;
  teamCount: number;
  topZoneCount: number;
  bottomZoneCount: number;
  topZoneLabel: string;
  bottomZoneLabel: string;
}

export async function getStaticPaths() {
  return (leaguesConfig as LeagueConfig[]).map((league) => ({
    params: { slug: league.slug },
    props: { league },
  }));
}

const { league } = Astro.props as { league: LeagueConfig };

const standingsModules = import.meta.glob<{ default: any }>('../../../../data/leagues/*-standings.json', {
  eager: true,
});
const extraModules = import.meta.glob<{ default: any }>('../../../../data/leagues/*-extra.json', { eager: true });
const raceModules = import.meta.glob<{ default: any }>('../../../../data/leagues/*-race.json', { eager: true });
const scorersModules = import.meta.glob<{ default: any }>('../../../../data/leagues/*-scorers.json', {
  eager: true,
});

function findModule(modules: Record<string, { default: any }>, code: string, suffix: string) {
  const key = Object.keys(modules).find((k) => k.endsWith(`/${code}-${suffix}.json`));
  return key ? modules[key].default : null;
}

const standingsData = findModule(standingsModules, league.code, 'standings');
const extraData = findModule(extraModules, league.code, 'extra');
const raceData = findModule(raceModules, league.code, 'race');
const scorersData = findModule(scorersModules, league.code, 'scorers');

const lang = 'pt' as const;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateFormatter = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const isMock = standingsData?.isMockData ?? true;
const lastUpdated = standingsData?.lastUpdated ? dateFormatter.format(new Date(standingsData.lastUpdated)) : null;
const top6 = (standingsData?.standings ?? []).slice(0, 6).map((row: { team: string }) => row.team);

const pageTitle = `${league.name} — ${t('ligas.hubTitle')}`;
const pageSubtitle = `Classificação, artilheiros e outras análises da ${league.name} (${league.country}).`;
---

<BaseLayout lang={lang} title={pageTitle} description={pageSubtitle}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14">
    <a href={`${base}/pt/dashboards/ligas/`} class="text-sm font-medium text-ember-600 hover:underline">
      {t('ligas.backToHub')}
    </a>

    <header class="mb-6 mt-4">
      <h1 class="font-serif-editorial text-3xl font-bold text-ink-950 sm:text-4xl">{league.name}</h1>
      <p class="mt-2 text-ink-700">{pageSubtitle}</p>
      {lastUpdated && !isMock && (
        <p class="mt-2 text-xs text-ink-400">{t('brasileirao.lastUpdated')} {lastUpdated}</p>
      )}
    </header>

    {isMock && (
      <p class="mb-8 rounded border border-ink-200 bg-ink-50 px-4 py-3 text-sm text-ink-600">
        {t('ligas.mockDataNotice')}
      </p>
    )}

    <div class="mb-10 rounded-lg border border-ink-100 bg-white p-4 sm:p-6">
      <BrasileiraoTable
        lang={lang}
        standings={standingsData?.standings ?? []}
        topZoneCount={league.topZoneCount}
        bottomZoneCount={league.bottomZoneCount}
        topZoneLabel={league.topZoneLabel}
        bottomZoneLabel={league.bottomZoneLabel}
      />
    </div>

    <section class="mb-10">
      <h2 class="font-serif-editorial text-xl font-bold text-ink-950">{t('brasileirao.scorersTitle')}</h2>
      <p class="mt-1 mb-4 text-sm text-ink-700">{t('ligas.scorersSubtitle')}</p>
      <div class="rounded-lg border border-ink-100 bg-white p-4 sm:p-6">
        <ScorersTable lang={lang} scorers={scorersData?.scorers ?? []} />
      </div>
    </section>

    <section class="mb-10">
      <h2 class="font-serif-editorial text-xl font-bold text-ink-950">{t('brasileirao.homeAwayTitle')}</h2>
      <p class="mt-1 mb-4 text-sm text-ink-700">{t('ligas.homeAwaySubtitle')}</p>
      <div class="rounded-lg border border-ink-100 bg-white p-4 sm:p-6">
        <HomeAwayTable lang={lang} teams={extraData?.teams ?? []} />
      </div>
    </section>

    <section class="mb-10">
      <h2 class="font-serif-editorial text-xl font-bold text-ink-950">{t('brasileirao.streaksTitle')}</h2>
      <p class="mt-1 mb-4 text-sm text-ink-700">{t('ligas.streaksSubtitle')}</p>
      <div class="rounded-lg border border-ink-100 bg-white p-4 sm:p-6">
        <StreaksTable lang={lang} teams={extraData?.teams ?? []} />
      </div>
    </section>

    <section class="mb-10">
      <h2 class="font-serif-editorial text-xl font-bold text-ink-950">{t('brasileirao.attackDefenseTitle')}</h2>
      <p class="mt-1 mb-4 text-sm text-ink-700">{t('ligas.attackDefenseSubtitle')}</p>
      <AttackDefenseScatter standings={standingsData?.standings ?? []} />
    </section>

    <AdSlot placement="in-article" class="mb-10" />

    <section class="mb-10">
      <h2 class="font-serif-editorial text-xl font-bold text-ink-950">{t('brasileirao.raceTitle')}</h2>
      <p class="mt-1 mb-4 text-sm text-ink-700">{t('ligas.raceSubtitle')}</p>
      <PointsRaceChart matchdays={raceData?.matchdays ?? []} series={raceData?.series ?? {}} highlightTeams={top6} />
    </section>

    <p class="mt-6 text-xs text-ink-400">
      {t('brasileirao.dataSource')}
      <a href="https://www.football-data.org/" target="_blank" rel="noopener noreferrer" class="underline hover:text-ember-600">football-data.org</a>.
    </p>
  </div>
</BaseLayout>
