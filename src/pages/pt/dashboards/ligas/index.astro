---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../../i18n/utils';
import leaguesConfig from '../../../../data/leagues-config.json';

const lang = 'pt' as const;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang={lang} title={t('ligas.hubTitle')} description={t('ligas.hubSubtitle')}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-8">
      <h1 class="font-serif-editorial text-3xl font-bold text-ink-950 sm:text-4xl">{t('ligas.hubTitle')}</h1>
      <p class="mt-2 text-ink-700">{t('ligas.hubSubtitle')}</p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {leaguesConfig.map((league) => (
        <a
          href={`${base}/pt/dashboards/ligas/${league.slug}/`}
          class="group rounded-lg border border-ink-100 bg-white p-5 transition-colors hover:border-ember-500"
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-ember-600">{league.country}</p>
          <h2 class="mt-1 font-serif-editorial text-xl font-bold text-ink-950 group-hover:text-ember-600">
            {league.name}
          </h2>
        </a>
      ))}
    </div>

    <p class="mt-10 text-sm text-ink-600">
      Procurando o Brasileirão?{' '}
      <a href={`${base}/pt/dashboards/brasileirao/`} class="text-ember-600 underline hover:text-ember-700">
        Ver tabela do Brasileirão →
      </a>
    </p>
  </div>
</BaseLayout>
