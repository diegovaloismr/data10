---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import XgPerMatchChart from '../../../components/charts/XgPerMatchChart.astro';
import PlayerRadarChart from '../../../components/charts/PlayerRadarChart.astro';
import MetricEvolutionChart from '../../../components/charts/MetricEvolutionChart.astro';
import { useTranslations } from '../../../i18n/utils';
import leaguesConfig from '../../../data/leagues-config.json';

const lang = 'pt' as const;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang={lang} title={t('dashboards.title')} description={t('dashboards.subtitle')}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-4">
      <h1 class="font-serif-editorial text-3xl font-bold text-ink-950 sm:text-4xl">{t('dashboards.title')}</h1>
      <p class="mt-2 text-ink-700">{t('dashboards.subtitle')}</p>
    </header>

    <div class="mb-10 flex flex-col gap-3">
      {leaguesConfig.map((competition) => (
        <a
          href={`${base}/pt/dashboards/brasileirao/#${competition.slug}`}
          class="flex flex-col gap-1 rounded-lg border border-ink-200 bg-ink-950 px-5 py-4 text-white transition-colors hover:border-ember-500"
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-ember-400">Dados reais</p>
          <h2 class="mt-1 font-serif-editorial text-xl font-bold">{competition.name}</h2>
          <p class="mt-1 text-sm text-ink-200">{t('dashboards.realDataBody')}</p>
          <span class="mt-3 text-sm font-medium text-ember-400">{t('dashboards.brasileiraoCta')} →</span>
        </a>
      ))}
    </div>

    <p class="mb-10 rounded border border-ink-200 bg-ink-50 px-4 py-3 text-sm text-ink-600">
      {t('dashboards.mockDataNotice')}
    </p>

    <section class="mb-12">
      <h2 class="font-serif-editorial text-2xl font-bold text-ink-950">{t('dashboards.xgTitle')}</h2>
      <p class="mt-2 mb-4 text-ink-700">{t('dashboards.xgBody')}</p>
      <XgPerMatchChart />
    </section>

    <AdSlot placement="in-article" class="mb-12" />

    <section class="mb-12">
      <h2 class="font-serif-editorial text-2xl font-bold text-ink-950">{t('dashboards.radarTitle')}</h2>
      <p class="mt-2 mb-4 text-ink-700">{t('dashboards.radarBody')}</p>
      <PlayerRadarChart />
    </section>

    <section class="mb-4">
      <h2 class="font-serif-editorial text-2xl font-bold text-ink-950">{t('dashboards.evolutionTitle')}</h2>
      <p class="mt-2 mb-4 text-ink-700">{t('dashboards.evolutionBody')}</p>
      <MetricEvolutionChart />
    </section>
  </div>
</BaseLayout>
