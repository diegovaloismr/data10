---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TranslationPending from '../../components/TranslationPending.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('footer.privacy')} description="Política de Privacidad de Data10." noIndex>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-8">
      <h1 class="font-serif-editorial text-3xl font-bold text-ink-950 sm:text-4xl">{t('footer.privacy')}</h1>
    </header>
    <TranslationPending lang={lang} />
  </div>
</BaseLayout>
