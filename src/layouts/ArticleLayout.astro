---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  tags: string[];
  readingTime?: number;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { lang, title, description, pubDate, updatedDate, author, category, tags, readingTime, cover, coverAlt } =
  Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateFormatter = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang, {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
// X/Twitter (e alguns outros crawlers de card social) não aceitam SVG como
// imagem de preview — as capas dos posts são SVG, então geramos uma versão
// PNG só para og:image/twitter:image, mantendo o SVG (mais leve) na página.
const ogImage = cover ? await getImage({ src: cover, format: 'png', width: 1200, height: 675 }) : undefined;
const ogImageURL = ogImage ? new URL(ogImage.src, Astro.site).toString() : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Data10',
    logo: { '@type': 'ImageObject', url: new URL(`${base}/favicon.svg`, Astro.site).toString() },
  },
  ...(ogImageURL && { image: ogImageURL }),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  keywords: tags.join(', '),
  articleSection: category,
  inLanguage: lang,
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  image={ogImage?.src}
  imageWidth={1200}
  imageHeight={675}
  type="article"
  articlePublishedTime={pubDate.toISOString()}
  articleModifiedTime={updatedDate?.toISOString()}
  articleAuthor={author}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-8">
      <a
        href={`${base}/${lang}/blog/`}
        class="text-sm font-medium text-ember-600 hover:underline"
      >
        ← {t('blog.backToBlog')}
      </a>

      {cover && (
        <div class="mt-5 aspect-[21/9] overflow-hidden rounded-lg bg-ink-950 shadow-sm">
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            width={1200}
            height={514}
            class="h-full w-full object-cover"
          />
        </div>
      )}

      <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-ember-600">{category}</p>
      <h1 class="mt-2 font-serif-editorial text-3xl font-bold leading-tight text-ink-950 sm:text-4xl">
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-600">
        <span>{t('blog.by')} {author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        {readingTime && (
          <>
            <span aria-hidden="true">·</span>
            <span>{readingTime} {t('blog.minRead')}</span>
          </>
        )}
      </div>

      {updatedDate && (
        <p class="mt-1 text-xs text-ink-400">
          {t('blog.updatedOn')} {dateFormatter.format(updatedDate)}
        </p>
      )}

      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-700">{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose-article">
      <slot />
    </div>

    <AdSlot placement="in-article" class="my-10" />
  </article>
</BaseLayout>
