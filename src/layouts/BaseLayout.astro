---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import { languages, type Lang } from '../i18n/utils';
import ogDefaultSvg from '../assets/og-default.svg';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  noIndex?: boolean;
  type?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  lang,
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  noIndex = false,
  type = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;

const siteName = 'Data10';
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
// Caminho da página atual sem o prefixo de idioma, para montar hreflang.
const pathWithoutLangAndBase = currentPath
  .replace(base, '')
  .replace(new RegExp(`^/(${Object.keys(languages).join('|')})`), '');

const canonicalURL = new URL(currentPath, Astro.site);
// X/Twitter (e outros crawlers de card social) não aceitam SVG como imagem
// de preview — geramos uma versão PNG da imagem padrão a partir do SVG
// autoral, só para essa finalidade.
const ogDefaultPng = await getImage({ src: ogDefaultSvg, format: 'png', width: 1200, height: 630 });
const ogImage = image ? new URL(image, Astro.site).toString() : new URL(ogDefaultPng.src, Astro.site).toString();
const ogImageWidth = image ? (imageWidth ?? 1200) : ogDefaultPng.attributes.width;
const ogImageHeight = image ? (imageHeight ?? 630) : ogDefaultPng.attributes.height;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-adsense-account" content="ca-pub-8302966077337193" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700;8..60,900&family=Inter:wght@400;500;600;700&display=swap"
    />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    {Object.keys(languages).map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={new URL(`${base}/${code}${pathWithoutLangAndBase}`, Astro.site).toString()}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`${base}/pt${pathWithoutLangAndBase}`, Astro.site).toString()}
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={lang} />

    {type === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {type === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {type === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href={`${base}/rss.xml`} />

    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink-950">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-ink-950 focus:px-3 focus:py-2 focus:text-white">
      Pular para o conteúdo
    </a>
    <Header lang={lang} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} privacyHref={`${base}/${lang}/privacidade/`} />
  </body>
</html>
