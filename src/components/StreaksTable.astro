---
import { useTranslations, type Lang } from '../i18n/utils';

interface TeamRow {
  team: string;
  form: string;
  unbeatenStreak: number;
}

interface Props {
  lang: Lang;
  teams: TeamRow[];
}

const { lang, teams } = Astro.props;
const t = useTranslations(lang);

const sorted = [...teams].sort((a, b) => b.unbeatenStreak - a.unbeatenStreak);

const badgeClasses: Record<string, string> = {
  V: 'bg-emerald-700/80 text-white',
  E: 'bg-ink-300 text-ink-800',
  D: 'bg-red-800/70 text-white',
};
---

<div class="overflow-x-auto">
  <table class="w-full min-w-[420px] border-collapse text-sm">
    <thead>
      <tr class="border-b border-ink-200 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="py-2 pr-2 font-medium">{t('brasileirao.team')}</th>
        <th class="py-2 px-2 text-center font-medium">{t('brasileirao.unbeatenStreak')}</th>
        <th class="py-2 pl-2 font-medium">{t('brasileirao.last5')}</th>
      </tr>
    </thead>
    <tbody>
      {sorted.map((row) => (
        <tr class="border-b border-ink-100 text-ink-800">
          <td class="py-2 pr-2 pl-3 font-medium text-ink-950">{row.team}</td>
          <td class="py-2 px-2 text-center font-bold text-ink-950">
            {row.unbeatenStreak} {t('brasileirao.matches')}
          </td>
          <td class="py-2 pl-2">
            <div class="flex gap-1">
              {row.form.split('').map((result) => (
                <span
                  class:list={[
                    'flex h-5 w-5 items-center justify-center rounded-full text-[10px] font-bold',
                    badgeClasses[result] ?? 'bg-ink-200 text-ink-600',
                  ]}
                >
                  {result}
                </span>
              ))}
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
