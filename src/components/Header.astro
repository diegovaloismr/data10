---
import { useTranslations, type Lang } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav = [
  { href: `${base}/${lang}/`, label: t('nav.home') },
  { href: `${base}/${lang}/blog/`, label: t('nav.blog') },
  { href: `${base}/${lang}/glossario/`, label: t('nav.glossario') },
  { href: `${base}/${lang}/dashboards/`, label: t('nav.dashboards') },
  { href: `${base}/${lang}/sobre/`, label: t('nav.sobre') },
];
---

<header class="border-b border-ink-100 bg-paper/95 backdrop-blur supports-[backdrop-filter]:sticky supports-[backdrop-filter]:top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={`${base}/${lang}/`} class="font-serif-editorial text-2xl font-bold tracking-tight text-ink-950">
      Data<span class="text-ember-500">10</span>
    </a>

    <nav class="hidden gap-6 md:flex" aria-label="Navegação principal">
      {nav.map((item) => (
        <a href={item.href} class="text-sm font-medium text-ink-700 transition-colors hover:text-ember-600">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} />
      <button
        id="mobile-menu-toggle"
        type="button"
        class="rounded border border-ink-200 p-2 text-ink-700 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Menu</span>
        ☰
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-ink-100 px-4 pb-4 md:hidden" aria-label="Navegação móvel">
    {nav.map((item) => (
      <a href={item.href} class="rounded px-2 py-2 text-sm font-medium text-ink-700 hover:bg-ink-50">
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
