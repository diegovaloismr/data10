---
import { useTranslations, type Lang } from '../i18n/utils';

interface Split {
  played: number;
  won: number;
  draw: number;
  lost: number;
  points: number;
}

interface TeamRow {
  team: string;
  home: Split;
  away: Split;
}

interface Props {
  lang: Lang;
  teams: TeamRow[];
}

const { lang, teams } = Astro.props;
const t = useTranslations(lang);

function ptsPerGame(split: Split) {
  return split.played > 0 ? (split.points / split.played).toFixed(2) : '—';
}

// Ordena pela maior diferença entre aproveitamento em casa e fora —
// destaca os times mais (ou menos) dependentes do fator casa.
const sorted = [...teams].sort((a, b) => {
  const diffA = a.home.played > 0 && a.away.played > 0 ? a.home.points / a.home.played - a.away.points / a.away.played : 0;
  const diffB = b.home.played > 0 && b.away.played > 0 ? b.home.points / b.home.played - b.away.points / b.away.played : 0;
  return diffB - diffA;
});
---

<div class="overflow-x-auto">
  <table class="w-full min-w-[520px] border-collapse text-sm">
    <thead>
      <tr class="border-b border-ink-200 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="py-2 pr-2 font-medium">{t('brasileirao.team')}</th>
        <th class="py-2 px-2 text-center font-medium" colspan="2">{t('brasileirao.home')}</th>
        <th class="py-2 pl-2 text-center font-medium" colspan="2">{t('brasileirao.away')}</th>
      </tr>
      <tr class="border-b border-ink-200 text-left text-xs text-ink-400">
        <th class="py-1 pr-2 font-normal"></th>
        <th class="py-1 px-2 text-center font-normal">{t('brasileirao.win')}-{t('brasileirao.draw')}-{t('brasileirao.lose')}</th>
        <th class="py-1 px-2 text-center font-normal">{t('brasileirao.ptsPerGame')}</th>
        <th class="py-1 px-2 text-center font-normal">{t('brasileirao.win')}-{t('brasileirao.draw')}-{t('brasileirao.lose')}</th>
        <th class="py-1 pl-2 text-center font-normal">{t('brasileirao.ptsPerGame')}</th>
      </tr>
    </thead>
    <tbody>
      {sorted.map((row) => (
        <tr class="border-b border-ink-100 text-ink-800">
          <td class="py-2 pr-2 pl-3 font-medium text-ink-950">{row.team}</td>
          <td class="py-2 px-2 text-center text-ink-600">{row.home.won}-{row.home.draw}-{row.home.lost}</td>
          <td class="py-2 px-2 text-center font-bold text-ink-950">{ptsPerGame(row.home)}</td>
          <td class="py-2 px-2 text-center text-ink-600">{row.away.won}-{row.away.draw}-{row.away.lost}</td>
          <td class="py-2 pl-2 text-center font-bold text-ink-950">{ptsPerGame(row.away)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
