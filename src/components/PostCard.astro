---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  readingTime?: number;
}

const { lang, slug, title, description, pubDate, category, readingTime } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateFormatter = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang, {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article class="group border-b border-ink-100 py-6 first:pt-0 last:border-0">
  <a href={`${base}/${lang}/blog/${slug}/`} class="block">
    <p class="text-xs font-semibold uppercase tracking-wider text-ember-600">{category}</p>
    <h3 class="mt-1 font-serif-editorial text-xl font-bold text-ink-950 group-hover:text-ember-600 sm:text-2xl">
      {title}
    </h3>
    <p class="mt-2 text-ink-700">{description}</p>
    <div class="mt-3 flex items-center gap-2 text-xs text-ink-400">
      <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
      {readingTime && (
        <>
          <span aria-hidden="true">·</span>
          <span>{readingTime} {t('blog.minRead')}</span>
        </>
      )}
    </div>
  </a>
</article>
