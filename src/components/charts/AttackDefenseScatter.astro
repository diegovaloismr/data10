---
interface StandingRow {
  team: string;
  crest: string | null;
  played: number;
  goalsFor: number;
  goalsAgainst: number;
}

interface Props {
  standings: StandingRow[];
}

const { standings } = Astro.props;

const points = standings
  .filter((row) => row.played > 0)
  .map((row) => ({
    team: row.team,
    crest: row.crest,
    x: Number((row.goalsFor / row.played).toFixed(2)),
    y: Number((row.goalsAgainst / row.played).toFixed(2)),
  }));

const chartData = JSON.stringify(points);
---

<div class="rounded-lg border border-ink-100 bg-white p-4 sm:p-6" data-chart="attack-defense" data-chart-payload={chartData}>
  <canvas height="340" role="img" aria-label="Gráfico de dispersão comparando gols marcados e sofridos por jogo de cada time, identificado pelo escudo"></canvas>
</div>

<script>
  import Chart from 'chart.js/auto';

  const FALLBACK_COLOR = '#d1590f';
  // Miniatura do escudo do tamanho do ponto que ela substitui — só um pouco
  // maior para o escudo continuar reconhecível como ícone, sem virar uma
  // mancha grande que sobrepõe pontos vizinhos.
  const CREST_RADIUS = 6;
  const CREST_HOVER_RADIUS = 9;
  const DOT_RADIUS = 5;
  const DOT_HOVER_RADIUS = 7;

  /** Pré-carrega os escudos (com timeout) para já nascerem prontos no primeiro desenho do gráfico. */
  function preloadCrest(url: string | null): Promise<HTMLImageElement | null> {
    if (!url) return Promise.resolve(null);
    return new Promise((resolve) => {
      const img = new Image();
      const timeout = setTimeout(() => resolve(null), 1200);
      img.onload = () => {
        clearTimeout(timeout);
        // Chart.js desenha pointStyle de imagem no tamanho de img.width/height
        // (não respeita pointRadius) — redimensiona aqui para o escudo
        // realmente nascer do tamanho do ponto, e não do tamanho original do arquivo.
        img.width = CREST_RADIUS * 2;
        img.height = CREST_RADIUS * 2;
        resolve(img);
      };
      img.onerror = () => {
        clearTimeout(timeout);
        resolve(null);
      };
      img.src = url;
    });
  }

  async function initWrapper(wrapper: HTMLElement) {
    if (wrapper.dataset.chartInitialized === 'true') return;
    const canvas = wrapper.querySelector('canvas');
    const payload = wrapper.dataset.chartPayload;
    if (!canvas || !payload) return;

    const points: { team: string; crest: string | null; x: number; y: number }[] = JSON.parse(payload);
    if (points.length === 0) return;

    wrapper.dataset.chartInitialized = 'true';

    const crestImages = await Promise.all(points.map((p) => preloadCrest(p.crest)));

    new Chart(canvas, {
      type: 'scatter',
      data: {
        datasets: [
          {
            label: 'Times',
            data: points,
            backgroundColor: FALLBACK_COLOR,
            pointStyle: points.map((_, i) => crestImages[i] ?? 'circle'),
            pointRadius: points.map((_, i) => (crestImages[i] ? CREST_RADIUS : DOT_RADIUS)),
            pointHoverRadius: points.map((_, i) => (crestImages[i] ? CREST_HOVER_RADIUS : DOT_HOVER_RADIUS)),
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (ctx) => {
                const p = points[ctx.dataIndex];
                return `${p.team}: ${p.x} gols marcados/jogo, ${p.y} sofridos/jogo`;
              },
            },
          },
        },
        scales: {
          x: {
            title: { display: true, text: 'Gols marcados por jogo', color: '#3d517d' },
            ticks: { color: '#3d517d' },
            grid: { color: '#e6eaf3' },
          },
          y: {
            title: { display: true, text: 'Gols sofridos por jogo', color: '#3d517d' },
            ticks: { color: '#3d517d' },
            grid: { color: '#e6eaf3' },
          },
        },
      },
    });
  }

  const wrappers = document.querySelectorAll<HTMLElement>('[data-chart="attack-defense"]');
  for (const wrapper of wrappers) {
    if (wrapper.offsetParent !== null) initWrapper(wrapper);
  }

  document.addEventListener('data10:panel-shown', (event) => {
    const panel = event.target as HTMLElement;
    panel.querySelectorAll<HTMLElement>('[data-chart="attack-defense"]').forEach(initWrapper);
  });
</script>
