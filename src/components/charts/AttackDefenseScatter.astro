---
import { lookupTeamColor, pickDistinctColors, DEFAULT_FALLBACK_COLORS } from '../../lib/team-color';

interface StandingRow {
  team: string;
  played: number;
  goalsFor: number;
  goalsAgainst: number;
}

interface Props {
  standings: StandingRow[];
}

const { standings } = Astro.props;

const activeTeams = standings.filter((row) => row.played > 0);

// Mesma lógica de cor da Corrida pelo título: cor de identidade real do time
// quando conhecida (nunca alterada), senão uma cor de fallback afastada de
// qualquer cor já usada por um time acima na prioridade (posição na tabela).
const rawColors = activeTeams.map((row, index) => {
  const known = lookupTeamColor(row.team);
  return { hex: known ?? DEFAULT_FALLBACK_COLORS[index % DEFAULT_FALLBACK_COLORS.length], protect: known !== null };
});
const colors = pickDistinctColors(rawColors);

const points = activeTeams.map((row, index) => ({
  team: row.team,
  x: Number((row.goalsFor / row.played).toFixed(2)),
  y: Number((row.goalsAgainst / row.played).toFixed(2)),
  color: colors[index],
}));

const chartData = JSON.stringify(points);
---

<div class="rounded-lg border border-ink-100 bg-white p-4 sm:p-6" data-chart="attack-defense" data-chart-payload={chartData}>
  <canvas height="340" role="img" aria-label="Gráfico de dispersão comparando gols marcados e sofridos por jogo de cada time, identificado por cor e legenda"></canvas>
</div>

<script>
  import Chart from 'chart.js/auto';

  function initWrapper(wrapper: HTMLElement) {
    if (wrapper.dataset.chartInitialized === 'true') return;
    const canvas = wrapper.querySelector('canvas');
    const payload = wrapper.dataset.chartPayload;
    if (!canvas || !payload) return;

    const points: { team: string; x: number; y: number; color: string }[] = JSON.parse(payload);
    if (points.length === 0) return;

    wrapper.dataset.chartInitialized = 'true';

    new Chart(canvas, {
      type: 'scatter',
      data: {
        datasets: points.map((p) => ({
          label: p.team,
          data: [{ x: p.x, y: p.y }],
          backgroundColor: p.color,
          borderColor: p.color,
          pointRadius: 6,
          pointHoverRadius: 8,
        })),
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { color: '#101a30', font: { family: 'Inter' }, boxWidth: 12 } },
          tooltip: {
            callbacks: {
              label: (ctx) => {
                const { x, y } = ctx.raw as { x: number; y: number };
                return `${ctx.dataset.label}: ${x} gols marcados/jogo, ${y} sofridos/jogo`;
              },
            },
          },
        },
        scales: {
          x: {
            title: { display: true, text: 'Gols marcados por jogo', color: '#3d517d' },
            ticks: { color: '#3d517d' },
            grid: { color: '#e6eaf3' },
          },
          y: {
            title: { display: true, text: 'Gols sofridos por jogo', color: '#3d517d' },
            ticks: { color: '#3d517d' },
            grid: { color: '#e6eaf3' },
          },
        },
      },
    });
  }

  const wrappers = document.querySelectorAll<HTMLElement>('[data-chart="attack-defense"]');
  for (const wrapper of wrappers) {
    if (wrapper.offsetParent !== null) initWrapper(wrapper);
  }

  document.addEventListener('data10:panel-shown', (event) => {
    const panel = event.target as HTMLElement;
    panel.querySelectorAll<HTMLElement>('[data-chart="attack-defense"]').forEach(initWrapper);
  });
</script>
