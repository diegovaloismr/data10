---
import { languages, getLocalizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<div class="relative inline-block">
  <label class="sr-only" for="lang-switcher">Idioma / Language / Idioma</label>
  <select
    id="lang-switcher"
    class="cursor-pointer rounded border border-ink-200 bg-transparent px-2 py-1 text-sm text-ink-800"
  >
    {Object.entries(languages).map(([code, label]) => (
      <option value={getLocalizedPath(currentPath, base, code as Lang)} selected={code === lang}>
        {label}
      </option>
    ))}
  </select>
</div>

<script>
  const select = document.getElementById('lang-switcher') as HTMLSelectElement | null;
  select?.addEventListener('change', () => {
    if (select.value) window.location.href = select.value;
  });
</script>
